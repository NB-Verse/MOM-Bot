# Copy this file to .env (never commit .env) or set these as environment variables on your host.

# ---------- App ----------
PORT=3000
# Public HTTPS address of this app, no trailing slash. Recall.ai and calendar sign-in use it.
PUBLIC_BASE_URL=https://your-app.onrender.com
# Where data is stored. On Render use the persistent disk: /var/data/data.json
DATA_FILE=data.json
TIMEZONE=Asia/Kolkata

# First admin account (created only when no users exist yet). Password: 10+ characters.
# Use your real name: by default the bot joins as "<your name> (Notetaker)". You can change it in the app.
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_NAME=Your Name

# Optional: only allow these email domains to register (comma separated)
ALLOWED_EMAIL_DOMAINS=
# Optional: only allow these meeting hosts (e.g. teams.microsoft.com)
ALLOWED_MEETING_HOSTS=

# ---------- Meeting bot (Recall.ai) ----------
# One of: us-west-2 (pay-as-you-go), us-east-1, eu-central-1, ap-northeast-1
RECALL_REGION=us-west-2
RECALL_API_KEY=
# Workspace verification secret (starts with whsec_) from Developers -> API Keys & Secrets
RECALL_VERIFICATION_SECRET=
# Only for Recall accounts created BEFORE 15 Dec 2025: the webhook endpoint's own signing secret
RECALL_SVIX_WEBHOOK_SECRET=

# Default bot name; {name} = the team member's name. Each person can override it in the app.
BOT_NAME={name} (Notetaker)
# BOT_JOIN_MESSAGE=Hi everyone, this is {name}'s AI notetaker. ...
# auto = detect language (handles English/Hindi mix). Or e.g. en, hi
TRANSCRIPT_LANGUAGE=auto
MOM_LANGUAGE=English

# ---------- Calendar ----------
# How far ahead bots are booked, and how often calendar links are checked
CALENDAR_LOOKAHEAD_HOURS=24
ICS_POLL_MINUTES=5
# Optional "Connect Google Calendar" button (Google Cloud OAuth client, redirect: PUBLIC_BASE_URL/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional "Connect Outlook" button (Azure app registration, redirect: PUBLIC_BASE_URL/oauth/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = any Microsoft account; or your company's tenant ID / domain
MICROSOFT_TENANT=common

# ---------- AI for the minutes ----------
# anthropic (default) or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# If LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
